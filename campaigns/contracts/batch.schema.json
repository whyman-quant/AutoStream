{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://whyman-quant.github.io/AutoStream/contracts/batch-v1.schema.json",
  "title": "AutoStream Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "batch_id", "campaign_id", "family_id", "generation", "parent_batch_ids", "parent_experience_ids", "hypothesis_id", "objective", "change_dimension", "candidate_ids", "search_policy", "created_at", "source_commit", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "batch"},
    "batch_id": {"$ref": "#/definitions/id"},
    "campaign_id": {"$ref": "#/definitions/id"},
    "family_id": {"$ref": "#/definitions/id"},
    "generation": {"type": "integer", "minimum": 0},
    "parent_batch_ids": {"type": "array", "items": {"$ref": "#/definitions/id"}, "uniqueItems": true},
    "parent_experience_ids": {"type": "array", "items": {"$ref": "#/definitions/id"}, "uniqueItems": true},
    "hypothesis_id": {"$ref": "#/definitions/id"},
    "objective": {"type": "string", "minLength": 1},
    "change_dimension": {"type": "string", "minLength": 1},
    "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
    "search_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "candidate_budget"],
      "properties": {
        "method": {"enum": ["mechanism_grid", "experience_variants", "dedup_replacement"]},
        "candidate_budget": {"type": "integer", "minimum": 1}
      }
    },
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "status": {"enum": ["proposed", "generated", "technical_complete", "pilot_complete", "formal_complete", "closed"]}
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"}
  }
}
