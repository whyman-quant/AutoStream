{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "proposal_id", "idea_id", "family_id", "mechanism", "formula", "inputs", "operators", "readiness", "falsification", "novelty_claim", "supported_events", "structure_signature"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "candidate_proposal"},
    "proposal_id": {"type": "string", "minLength": 1}, "idea_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1}, "mechanism": {"type": "string", "minLength": 1},
    "formula": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["quote", "trade", "order"]}},
    "operators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "readiness": {"type": "string", "minLength": 1}, "falsification": {"type": "string", "minLength": 1},
    "novelty_claim": {"type": "string", "minLength": 1},
    "supported_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 2359}},
    "structure_signature": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
